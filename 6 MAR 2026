WHILE LOOP



Print 1st 10 numbers using while loop

create or replace procedure whileloopto10
as 
	i number := 1;

Begin
	while i<=10 Loop
		DBMS_OUTPUT.PUT_LINE(i);
		i := i+1;
	End Loop;
End;



print first 10 even numbers

create or replace procedure evennumprint
as
	i number := 2;
	c number := 1;
Begin
	while c <= 10 loop
		DBMS_OUTPUT.PUT_LINE(i);
		i := i + 2;
		c := c + 1;
	End Loop;
End;


print summation of 1st 10 numbers

create or replace procedure summation10
as 
	i number := 1;
	a number := 0;

Begin
	while i<=10 Loop
		a := a + i;
		i := i+1;
	End Loop;
	DBMS_OUTPUT.PUT_LINE(a);
End;

FOR LOOP



Print 1st 10 numbers using for loop

create or replace procedure forloopto10
as 
Begin
	for i in 1..10 Loop
		DBMS_OUTPUT.PUT_LINE(i);
	End Loop;
End;

