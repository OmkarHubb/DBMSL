IF CONDITION


create or replace procedure ifelsecase1
as
	CS number := 45;
	OS number := 50;
	DBMS number := 75;
	M3 number := 95;
	Total number;
	Perc number;
Begin
 	if CS > 50 && OS > 50 && DBMS > 50 && M3 > 50
		Total = CS + OS + DBMS + M3;
		Perc = (Total/4) * 100;
		DBMS_OUTPUT.PUT_LINE(Total);
		DBMS_OUTPUT.PUT_LINE(Perc);
		
		if perc > 90
			DBMS_OUTPUT.PUT_LINE("A");
		elsif perc > 75 && perc < 90
 			DBMS_OUTPUT.PUT_LINE("B");
		elsif perc > 50 && perc < 75
			DBMS_OUTPUT.PUT_LINE("C");
		else
			DBMS_OUTPUT.PUT_LINE("F");
		End if;
	else
		DBMS_OUTPUT.PUT_LINE("FAIL");
	End if;
End;





