3. Now add one more field salary to table

alter table emp3 add(salary integer);


now write a trigger for insert or update salary field as for: 
1.	category 1 salary should be more than 10000
2.	category 2 salary should be more than 20000
3.	category 3 salary should be more than 30000

CREATE OR REPLACE TRIGGER emp2_salary
BEFORE INSERT OR UPDATE ON emp2
FOR EACH ROW
BEGIN
    IF :NEW.category = 1 AND :NEW.salary < 10000 THEN
        raise_application_error(-20001,'Salary should be more than 10000');

    ELSIF :NEW.category = 2 AND :NEW.salary < 20000 THEN
        raise_application_error(-20002, 'Salary should be more than 20000');

    ELSIF :NEW.category = 3 AND :NEW.salary < 30000 THEN
        raise_application_error(-20004, 'Salary should be more than 30000');
    END IF;
END;
/

