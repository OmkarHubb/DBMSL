1.	Create table emp2 with fields empno as int, name as char, category as int and write a trigger for insert or update on emp2 for new record in uppercase only
using command like name = upper(name)


CREATE TABLE emp2 (empno integer, name varchar(20), category integer);

CREATE OR REPLACE TRIGGER emp_trg
BEFORE INSERT OR UPDATE ON emp2
FOR EACH ROW
BEGIN
    :NEW.name := UPPER(:NEW.name);
END;
/


